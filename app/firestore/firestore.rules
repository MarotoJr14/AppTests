rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── topics (read-only for authenticated users) ────────────────────────
    match /topics/{topicId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── questions (read-only for authenticated users) ─────────────────────
    match /questions/{questionId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── users (own profile only) ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── exams (own exams only) ───────────────────────────────────────────
    match /exams/{examId} {
      // Read & update: only the owner
      allow read, update, delete: if isAuth()
        && resource.data.userId == request.auth.uid;
      // Create: userId in new doc must match caller
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
    }

    // ── userTopicStats (own stats only) ──────────────────────────────────
    match /userTopicStats/{docId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuth()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
